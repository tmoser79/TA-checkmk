#!/usr/bin/env python3
# Splunk HTTP Event Collector
# Bulk: no
"""Send Checkmk notifications to Splunk HEC as CIM Alerts JSON.

Install:
  cp splunk_hec ~/local/share/check_mk/notifications/splunk_hec
  chmod 755 ~/local/share/check_mk/notifications/splunk_hec

Parameters (named, Checkmk 2.3/2.4 ruleset) or positional:
  1 / hec_url      HEC URL, e.g. https://splunk.example.com:8088/services/collector/event
  2 / hec_token    HEC token, or a Checkmk password-store reference ("store <id>")
  3 / index        Destination index (default: checkmk)
  4 / sourcetype   Sourcetype (default: checkmk:alert)
  5 / verify_tls   yes/no (default: yes)

Exit 0 on success, 1 for retryable HTTP errors, 2 for permanent errors.
"""

from __future__ import annotations

import json
import os
import socket
import ssl
import sys
import urllib.error
import urllib.request
from typing import Dict, Optional
from urllib.parse import urlparse

SEVERITY_MAP = {
    "CRITICAL": ("critical", "5"),
    "CRIT": ("critical", "5"),
    "DOWN": ("critical", "5"),
    "UNREACHABLE": ("high", "4"),
    "UNREACH": ("high", "4"),
    "WARNING": ("medium", "3"),
    "WARN": ("medium", "3"),
    "UNKNOWN": ("low", "2"),
    "OK": ("informational", "1"),
    "UP": ("informational", "1"),
    "RECOVERY": ("informational", "1"),
}

TRUTHY = {"1", "true", "yes", "on"}


def collect_context() -> Dict[str, str]:
    try:
        from cmk.notification_plugins.utils import collect_context as cmk_collect

        return dict(cmk_collect())
    except Exception:
        return {
            key[7:]: value
            for key, value in os.environ.items()
            if key.startswith("NOTIFY_")
        }


def resolve_secret(value: Optional[str]) -> Optional[str]:
    if not value:
        return value
    parts = value.split()
    if parts and parts[0] == "store":
        try:
            from cmk.notification_plugins.utils import retrieve_from_passwordstore

            return retrieve_from_passwordstore(value)
        except Exception as exc:
            sys.stderr.write(f"Unable to read password store value: {exc}\n")
            raise
    return value


def first_present(context: Dict[str, str], *keys: str) -> Optional[str]:
    for key in keys:
        value = context.get(key)
        if value:
            return value
    return None


def is_true(value: Optional[str], default: bool = True) -> bool:
    if value is None or value == "":
        return default
    return value.strip().lower() in TRUTHY


def map_severity(vendor_severity: Optional[str]) -> tuple[str, str]:
    if not vendor_severity:
        return "informational", "1"
    mapped = SEVERITY_MAP.get(vendor_severity.strip().upper())
    if mapped:
        return mapped
    return "informational", "1"


def plugin_params(context: Dict[str, str]) -> Dict[str, str]:
    url = first_present(
        context, "PARAMETER_HEC_URL", "PARAMETER_hec_url", "PARAMETER_1"
    )
    token = first_present(
        context,
        "PARAMETER_HEC_TOKEN",
        "PARAMETER_hec_token",
        "PARAMETER_TOKEN",
        "PARAMETER_2",
    )
    index = first_present(context, "PARAMETER_INDEX", "PARAMETER_index", "PARAMETER_3") or "checkmk"
    sourcetype = (
        first_present(context, "PARAMETER_SOURCETYPE", "PARAMETER_sourcetype", "PARAMETER_4")
        or "checkmk:alert"
    )
    verify = (
        first_present(context, "PARAMETER_VERIFY_TLS", "PARAMETER_verify_tls", "PARAMETER_5")
        or "yes"
    )
    if not url or not token:
        raise ValueError(
            "Missing HEC URL or token. Pass hec_url and hec_token (or PARAMETER_1/2)."
        )
    return {
        "url": url.strip(),
        "token": resolve_secret(token.strip()) or "",
        "index": index.strip(),
        "sourcetype": sourcetype.strip(),
        "verify_tls": verify.strip(),
    }


def looks_like_ip(value: Optional[str]) -> bool:
    if not value:
        return False
    try:
        socket.inet_pton(socket.AF_INET, value)
        return True
    except OSError:
        try:
            socket.inet_pton(socket.AF_INET6, value)
            return True
        except OSError:
            return False


def epoch_from_context(context: Dict[str, str]) -> Optional[int]:
    micro = context.get("MICROTIME")
    if micro and micro.isdigit():
        return int(micro) // 1_000_000
    return None


def build_event(context: Dict[str, str]) -> Dict[str, object]:
    what = (context.get("WHAT") or "SERVICE").upper()
    host = context.get("HOSTNAME") or context.get("HOSTALIAS") or "unknown"
    service = context.get("SERVICEDESC")
    if what == "HOST":
        vendor = context.get("HOSTSTATE") or "UNKNOWN"
        output = context.get("HOSTOUTPUT") or ""
        signature = "Host Check"
        signature_id = context.get("HOSTCHECKCOMMAND")
        problem_id = context.get("HOSTPROBLEMID")
        url = context.get("HOSTURL")
        check_command = context.get("HOSTCHECKCOMMAND")
    else:
        vendor = context.get("SERVICESTATE") or "UNKNOWN"
        output = context.get("SERVICEOUTPUT") or ""
        signature = service or "Service"
        signature_id = context.get("SERVICECHECKCOMMAND")
        problem_id = context.get("SERVICEPROBLEMID")
        url = context.get("SERVICEURL") or context.get("HOSTURL")
        check_command = context.get("SERVICECHECKCOMMAND")

    severity, severity_id = map_severity(vendor)
    dest_ip = context.get("HOSTADDRESS")
    event: Dict[str, object] = {
        "app": "checkmk",
        "vendor_product": "Checkmk",
        "type": "alert",
        "id": problem_id or f"{host}:{signature}:{context.get('SHORTDATETIME', '')}",
        "dest": host,
        "dest_host": host,
        "signature": signature,
        "vendor_severity": vendor,
        "severity": severity,
        "severity_id": severity_id,
        "description": output,
        "body": output,
        "subject": " ".join(
            part
            for part in (
                context.get("NOTIFICATIONTYPE"),
                host,
                service if what == "SERVICE" else None,
            )
            if part
        ),
        "src": context.get("MONITORING_HOST") or socket.gethostname(),
        "user": context.get("CONTACTNAME"),
        "notification_type": context.get("NOTIFICATIONTYPE"),
        "what": what,
        "site": os.environ.get("OMD_SITE") or context.get("OMD_SITE"),
        "check_command": check_command,
        "host_alias": context.get("HOSTALIAS"),
        "host_groups": context.get("HOSTGROUPNAMES"),
        "service_groups": context.get("SERVICEGROUPNAMES"),
        "notification_comment": context.get("NOTIFICATIONCOMMENT"),
    }
    if signature_id:
        event["signature_id"] = signature_id
    if looks_like_ip(dest_ip):
        event["dest_ip"] = dest_ip
    if url:
        event["url"] = url
    return {key: value for key, value in event.items() if value not in (None, "")}


def build_payload(context: Dict[str, str], params: Dict[str, str]) -> Dict[str, object]:
    payload: Dict[str, object] = {
        "host": params.get("source_host")
        or context.get("MONITORING_HOST")
        or socket.gethostname(),
        "source": "checkmk:notification",
        "sourcetype": params["sourcetype"],
        "index": params["index"],
        "event": build_event(context),
    }
    epoch = epoch_from_context(context)
    if epoch:
        payload["time"] = epoch
    return payload


def post_hec(url: str, token: str, payload: Dict[str, object], verify_tls: bool) -> int:
    parsed = urlparse(url)
    if parsed.scheme not in ("http", "https"):
        sys.stderr.write("HEC URL must be http or https\n")
        return 2
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Splunk {token}",
            "Content-Type": "application/json",
        },
    )
    context = ssl.create_default_context()
    if not verify_tls:
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(request, timeout=15, context=context) as response:
            body = response.read().decode("utf-8", errors="replace")
            print(f"Successfully sent to Splunk HEC ({response.status}): {body[:200]}")
            return 0
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")[:300]
        print(f"HEC HTTP {exc.code}: {detail}")
        if exc.code in (408, 429) or exc.code >= 500:
            return 1
        return 2
    except urllib.error.URLError as exc:
        print(f"HEC connection failed: {exc.reason}")
        return 1


def main() -> int:
    context = collect_context()
    try:
        params = plugin_params(context)
    except ValueError as exc:
        print(str(exc))
        return 2
    if not params["token"]:
        print("HEC token resolved empty")
        return 2
    payload = build_payload(context, params)
    return post_hec(
        params["url"],
        params["token"],
        payload,
        is_true(params["verify_tls"], True),
    )


if __name__ == "__main__":
    sys.exit(main())
